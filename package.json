{
  "name": "aalwyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "compile": "tsx src/cli.ts",
    "trace": "tsx src/trace-cli.ts",
    "video:trace": "tsx src/trace-cli.ts video/examples/intro.aal --out video/src/trace.json",
    "video:install": "npm ci --prefix video",
    "video": "npm run video:trace && npm --prefix video start",
    "video:build": "npm run video:trace && npm --prefix video run build",
    "video:willans": "tsx video/scripts/willans-trace.ts && npm --prefix video start",
    "video:willans:build": "tsx video/scripts/willans-trace.ts && npm --prefix video run build",
    "video:prime-log": "tsx video/scripts/prime-log-trace.ts && npm --prefix video start",
    "video:prime-log:build": "tsx video/scripts/prime-log-trace.ts && npm --prefix video run build",
    "video:opening": "tsx video/scripts/opening-assets.ts && npm --prefix video start",
    "video:opening:build": "tsx video/scripts/opening-assets.ts && npm --prefix video run build",
    "video:series": "tsx video/scripts/series-traces.ts && npm --prefix video start",
    "video:series:build": "tsx video/scripts/series-traces.ts && npm --prefix video run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
