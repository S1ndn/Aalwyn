// Each iteration starts a fresh term. Bounds are inclusive integers.
fn squares(int a, int b)
    = sum i from a to b (
        = i^2
        -= a ? (i < 2)
    )
end

// Set each factor directly; the product multiplies the completed terms.
fn productRange(natural n)
    = prod i from 1 to n (
        = i
    )
end
