// Each index builds one independent term. Bounds are inclusive integers.

// conditional contribution inside each term

fn squares(real a, real b)
    += sum i from a to b (
        += (i ^ 2)
        -= a ? (i < 2)
    )
end

fn productRange(real n)
    += 1
    *= prod i from 1 to n (
        += 1
        *= i
    )
end
